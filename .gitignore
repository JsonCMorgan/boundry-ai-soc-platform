# Secrets - never commit
.env
.flask_secret_key
.terminal_token
.webui_secret_key

# Generated audit/report files
COMMIT_PUSH_REPORT.txt
_git_audit.txt

# Boundry.AI operational files — internal only
clients.json
alert_state.json
alert_task.xml
inspect_db.py
*.db
instance/
docs/LAB_CREDENTIALS.md

# Vendor exam objective PDFs (copyrighted; keep local only)
# Track README + JSON matrices under docs/exam-outlines/; ignore the PDFs.
docs/exam-outlines/*.pdf
docs/exam-outlines/_*-extract.txt
!docs/exam-outlines/README.md

# Logs - never commit
*.log
docs/reports/incident_report_*.md

# Local DB backups (M6)
backups/

# Python
__pycache__/
.venv/
*.egg-info/
.pytest_cache/

# IDE
.idea/
.vscode/

# macOS
.DS_Store

# Claude session files
.claude/

# Boundry.AI agent skill progress files (keep README)
agent_tasks/*.md
!agent_tasks/README.md

# Local secret loaders (never commit)
.boundry_env.ps1
*_profile_backup_*.ps1

